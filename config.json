{
  "$schema": "./config.schema.json",

  "name": "Jane Doe",
  "bio": "Quick description. Quick description. Quick description.\nSecond line, with a [link](https://example.com) in it.",
  "avatar": null,

  "meta": {
    "title": "Jane Doe",
    "description": "Links for Jane Doe.",
    "url": "https://example.com",
    "themeColor": "#000000",
    "image": null,
    "socialCard": {
      "enabled": true,
      "instance": "bio.example.com",
      "description": "Quick description for social sharing.",
      "showAvatar": true,
      "ribbon": "links", // "links" uses your link colors; "custom" uses ribbonColors; "none" hides it
      "ribbonColors": ["#ff6b6b", "#4dabf7", "#ffffff", "#f08c00"]
    }
  },

  "theme": {
    "accent": "#ffffff",
    "brandColors": true,
    "hideKeyHintsOnMobile": true,
    "font": "Roboto, Arial, sans-serif",
    "radius": "999px"
  },

  "links": [
    { "name": "GitHub",    "url": "https://github.com/janedoe", "group": "Elsewhere" },
    { "name": "YouTube",   "url": "https://youtube.com/@janedoe", "group": "Elsewhere" },
    { "name": "Twitter",   "url": "https://x.com/janedoe", "group": "Elsewhere" },
    { "name": "Instagram", "url": "https://instagram.com/janedoe", "group": "Elsewhere" }
  ],

  "footer": "Powered by **Midnight**"
}
